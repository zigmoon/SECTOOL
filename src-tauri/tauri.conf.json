{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SECTOOL",
  "version": "0.2.0",
  "identifier": "cc.zigmoon.sectool",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "npm --prefix app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SECTOOL — Réseau & Pare-feu",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#070b12",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "zigmoon",
    "copyright": "© 2026 zigmoon — AGPL-3.0",
    "category": "Utility",
    "shortDescription": "Voir tout son réseau en temps réel et le contrôler",
    "longDescription": "SECTOOL affiche en temps réel les appareils du réseau local (ordinateurs, box, téléphones, imprimantes, objets connectés), les connexions de la machine et propose un pare-feu logiciel simple, avec aperçu avant application.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["nftables"]
      }
    }
  }
}
