---
import '../styles/app.css';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>SECTOOL — Réseau &amp; Pare-feu</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="app">
      <aside class="side">
        <div class="brand">
          <img src="/favicon.svg" alt="" width="34" height="34" />
          <div><strong>SECTOOL</strong><small id="ver">v0.1.0</small></div>
        </div>
        <nav id="nav" aria-label="Sections"></nav>
        <div class="side-foot">
          <div class="pill" id="fw-pill"></div>
          <div class="muted tiny" id="host"></div>
        </div>
      </aside>

      <main class="main">
        <div id="demo-banner" class="banner" hidden>
          Mode démonstration : données fictives affichées dans le navigateur. Lancez l'application de bureau pour voir votre vrai réseau.
        </div>

        <header class="top">
          <div class="stats" id="stats"></div>
          <div class="traffic">
            <div class="traffic-head">
              <span class="rx" id="rx"></span><span class="tx" id="tx"></span>
              <button class="btn ghost" id="btn-scan" title="Relancer un balayage"></button>
            </div>
            <canvas id="chart" width="520" height="86" aria-label="Débit réseau en temps réel"></canvas>
          </div>
        </header>

        <section id="view" class="view" aria-live="polite"></section>
      </main>
    </div>

    <div id="toast" class="toast" role="status" hidden></div>
    <dialog id="dialog"></dialog>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
